{
  "annotations": {
    "list": [
      {
        "name": "Deploys",
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "iconColor": "#8b5cf6",
        "target": { "limit": 100, "matchAny": false, "tags": ["deploy"], "type": "tags" }
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 100,
      "type": "text",
      "title": "",
      "transparent": true,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 4 },
      "options": {
        "mode": "markdown",
        "content": "# 💰 Business — Revenue and dock occupancy\n\nMoney earned in the **selected period** (change the range in the top-right corner — minimum 1h) + **CR/h trend** (are we growing) + **current dock occupancy**. A red gauge = the port is empty (lost revenue) **or** full (no room for new reservations).\n\n> The numbers are an *indicator* from metrics, not a general ledger — use the transactional database for financial reporting."
      }
    },

    {
      "id": 1,
      "type": "stat",
      "title": "Total revenue in the selected period",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 7 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "sum(increase(reservations_fees_calculated_amount_cr_sum[$__range]))",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: CR",
          "decimals": 0,
          "noValue": "0",
          "color": { "mode": "fixed", "fixedColor": "#10b981" }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },

    {
      "id": 8,
      "type": "timeseries",
      "title": "Revenue/h — trend (are we growing?)",
      "description": "rate() of the fee sum × 3600 = credits/hour. Shows the DIRECTION, not an accounting total. rate() is resilient to counter resets on application restart. Vertical lines = deploys (annotations tagged 'deploy').",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "x": 0, "y": 11, "w": 24, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "editorMode": "code",
          "expr": "sum(rate(reservations_fees_calculated_amount_cr_sum[$__rate_interval])) * 3600",
          "legendFormat": "TOTAL",
          "range": true
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "editorMode": "code",
          "expr": "sum by (shipClass) (rate(reservations_fees_calculated_amount_cr_sum[$__rate_interval])) * 3600",
          "legendFormat": "{{shipClass}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: CR/h",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "spanNulls": true,
            "showPoints": "auto",
            "axisGridShow": false,
            "axisBorderShow": false
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "RAZEM" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#10b981" } },
              { "id": "custom.lineWidth", "value": 3 }
            ] },
          { "matcher": { "id": "byName", "options": "SCOUT" },     "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#0ea5e9" } }] },
          { "matcher": { "id": "byName", "options": "FREIGHTER" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#22c55e" } }] },
          { "matcher": { "id": "byName", "options": "CRUISER" },   "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#8b5cf6" } }] }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max", "mean"], "showLegend": true }
      }
    },

    {
      "id": 2,
      "type": "bargauge",
      "title": "Revenue per port",
      "description": "Which port earned the most in the selected period.",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "x": 0, "y": 19, "w": 12, "h": 10 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "sum by (starport) (increase(reservations_fees_calculated_amount_cr_sum[$__range]))",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "{{starport}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: CR",
          "decimals": 0,
          "noValue": "0",
          "min": 0,
          "color": { "mode": "fixed", "fixedColor": "#10b981" }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "minVizWidth": 0,
        "minVizHeight": 16,
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },

    {
      "id": 3,
      "type": "bargauge",
      "title": "Revenue per ship class",
      "description": "SCOUT / FREIGHTER / CRUISER — which class brings in the most revenue.",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "x": 12, "y": 19, "w": 12, "h": 10 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "sum by (shipClass) (increase(reservations_fees_calculated_amount_cr_sum[$__range]))",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "{{shipClass}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: CR",
          "decimals": 0,
          "noValue": "0",
          "min": 0,
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "SCOUT" },     "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#0ea5e9" } }] },
          { "matcher": { "id": "byName", "options": "FREIGHTER" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#10b981" } }] },
          { "matcher": { "id": "byName", "options": "CRUISER" },   "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#8b5cf6" } }] },
          { "matcher": { "id": "byName", "options": "UNKNOWN" },   "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#94a3b8" } }] }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "minVizWidth": 0,
        "minVizHeight": 16,
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },

    {
      "id": 4,
      "type": "bargauge",
      "title": "Reservation rejection rate per class — lost conversion",
      "description": "Share of reservation attempts that ended in a refusal (outcome != confirmed: no_capacity / route_unavailable / error) instead of a confirmation, per ship class, in the selected period. A tall bar = we are losing customers of that class → decision: add capacity / redirect traffic. The dominant cause is usually 'no_capacity' — correlated with the dock occupancy gauge below. Green <10%, orange 10–25%, red >25%.",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "x": 0, "y": 29, "w": 12, "h": 10 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "sum by (shipClass) (increase(reservations_total{outcome!=\"confirmed\"}[$__range])) / clamp_min(sum by (shipClass) (increase(reservations_total[$__range])), 1)",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "{{shipClass}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "noValue": "0",
          "min": 0,
          "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#10b981", "value": null },
              { "color": "#f59e0b", "value": 0.1 },
              { "color": "#f43f5e", "value": 0.25 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "minVizWidth": 0,
        "minVizHeight": 16,
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },

    {
      "id": 5,
      "type": "bargauge",
      "title": "Average revenue per reservation",
      "description": "Total revenue divided by the number of reservations — which class leaves the most money per visit.",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "x": 12, "y": 29, "w": 12, "h": 10 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "sum by (shipClass) (increase(reservations_fees_calculated_amount_cr_sum[$__range])) / clamp_min(sum by (shipClass) (increase(reservations_fees_calculated_amount_cr_count[$__range])), 1)",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "{{shipClass}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: CR",
          "decimals": 0,
          "noValue": "0",
          "min": 0,
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "SCOUT" },     "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#0ea5e9" } }] },
          { "matcher": { "id": "byName", "options": "FREIGHTER" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#10b981" } }] },
          { "matcher": { "id": "byName", "options": "CRUISER" },   "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#8b5cf6" } }] },
          { "matcher": { "id": "byName", "options": "UNKNOWN" },   "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#94a3b8" } }] }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "minVizWidth": 0,
        "minVizHeight": 16,
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },

    {
      "id": 6,
      "type": "gauge",
      "title": "Dock occupancy per port — NOW (red: <50% empty / >97% full)",
      "description": "Current dock occupancy. Low (<50%) = empty docks = lost revenue. Very high (>97%) = no room for new reservations = also lost revenue and overbooking risk. Optimal band 50–90% (green). If 'no data' — rebuild/restart starport-registry (DockOccupancyObserver).",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "x": 0, "y": 39, "w": 24, "h": 12 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "max by (starport) (reservations_docks_occupied_ratio)",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "{{starport}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "min": 0,
          "max": 1,
          "noValue": "no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#f43f5e", "value": null },
              { "color": "#10b981", "value": 0.5 },
              { "color": "#f59e0b", "value": 0.9 },
              { "color": "#f43f5e", "value": 0.97 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },

    {
      "id": 7,
      "type": "table",
      "title": "Docks occupied / capacity — NOW",
      "description": "Raw numbers behind the gauges: how many docks are currently reserved and how many exist in total. The 'Occupancy' column is an inline gauge.",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "x": 0, "y": 51, "w": 24, "h": 10 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "max by (starport) (reservations_docks_occupied)",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "max by (starport) (reservations_docks_capacity)",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "max by (starport) (reservations_docks_occupied_ratio)",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Time 1": true, "Time 2": true, "Time 3": true },
            "indexByName": { "starport": 0, "Value #A": 1, "Value #B": 2, "Value #C": 3 },
            "renameByName": {
              "starport": "Port",
              "Value #A": "Occupied",
              "Value #B": "Capacity",
              "Value #C": "Occupancy"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "center", "displayMode": "auto" },
          "noValue": "no data"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Occupancy" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              { "id": "decimals", "value": 0 },
              { "id": "min", "value": 0 },
              { "id": "max", "value": 1 },
              { "id": "custom.displayMode", "value": "gradient-gauge" },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "#f43f5e", "value": null },
                    { "color": "#10b981", "value": 0.5 },
                    { "color": "#f59e0b", "value": 0.9 },
                    { "color": "#f43f5e", "value": 0.97 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Occupied" },
            "properties": [
              { "id": "unit", "value": "none" },
              { "id": "decimals", "value": 0 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Capacity" },
            "properties": [
              { "id": "unit", "value": "none" },
              { "id": "decimals", "value": 0 }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Occupancy", "desc": true }]
      }
    },

    {
      "id": 8,
      "type": "timeseries",
      "title": "Reservation conversion — % confirmed",
      "description": "Share of reservation attempts that ended in a confirmation (outcome=confirmed) out of all attempts. A real business KPI: a drop = we are losing conversion — correlate with rejections per class above. Moved from the retired 'Microservices Fleet Dashboard'.",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "x": 0, "y": 61, "w": 24, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "editorMode": "code",
          "expr": "100 * sum(rate(reservations_total{outcome=\"confirmed\"}[$__rate_interval])) / clamp_min(sum(rate(reservations_total[$__rate_interval])), 1e-9)",
          "legendFormat": "% confirmed",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#f43f5e", "value": null },
              { "color": "#f59e0b", "value": 75 },
              { "color": "#10b981", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
